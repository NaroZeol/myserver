[Unit]
Description=Publish queued Thoughts to Gist
After=network-online.target thoughts.service

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
WorkingDirectory=@DATA_DIR@/app
Environment=PYTHONPATH=@DATA_DIR@/python
Environment=THOUGHTS_DATABASE=@DATA_DIR@/thoughts.sqlite
ExecStart=/usr/bin/python3 publisher.py
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@DATA_DIR@
