<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="app.thoughts.mobile" android:versionCode="18" android:versionName="1.12.0">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
  <application android:label="myserver" android:theme="@style/AppTheme" android:icon="@drawable/ic_launcher" android:allowBackup="false" android:usesCleartextTraffic="false" android:supportsRtl="true">
    <activity android:name="app.thoughts.mobile.shell.updates.UpdateActivity" android:exported="false" android:configChanges="orientation|screenSize" />
    <provider android:name="app.thoughts.mobile.shell.updates.UpdateFileProvider" android:authorities="app.thoughts.mobile.updates" android:exported="false" android:grantUriPermissions="true" />
    <receiver android:name="app.thoughts.mobile.shell.updates.UpdateReceiver" android:exported="true">
      <intent-filter><action android:name="android.intent.action.DOWNLOAD_COMPLETE" /></intent-filter>
    </receiver>
    <activity android:name="app.thoughts.mobile.modules.inbox.InboxPreviewActivity" android:exported="false" android:configChanges="orientation|screenSize" />
    <service android:name="app.thoughts.mobile.modules.inbox.TransferService" android:exported="false" android:foregroundServiceType="dataSync" />
    <provider android:name="app.thoughts.mobile.modules.inbox.InboxFileProvider" android:authorities="app.thoughts.mobile.inbox.files" android:exported="false" android:grantUriPermissions="true" />
    <activity android:name="app.thoughts.mobile.modules.inbox.InboxShareActivity" android:label="发送到收件箱" android:exported="true" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|keyboardHidden">
      <intent-filter><action android:name="android.intent.action.SEND"/><category android:name="android.intent.category.DEFAULT"/><data android:mimeType="*/*"/></intent-filter>
      <intent-filter><action android:name="android.intent.action.SEND_MULTIPLE"/><category android:name="android.intent.category.DEFAULT"/><data android:mimeType="*/*"/></intent-filter>
    </activity>
    <service android:name="app.thoughts.mobile.modules.terminal.TerminalService" android:exported="false" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started interactive SSH terminal session with ongoing notification and explicit disconnect action" />
    </service>
    <service android:name="app.thoughts.mobile.modules.server.PortForwardService" android:exported="false" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started SSH local port forwarding to a phone-local listener with explicit stop action" />
    </service>
    <activity android:name="app.thoughts.mobile.modules.server.PortForwardActivity" android:exported="false" />
    <activity android:name="app.thoughts.mobile.modules.terminal.TerminalActivity" android:launchMode="singleTop" android:exported="false" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|keyboardHidden" />
    <activity android:name="app.thoughts.mobile.MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|keyboardHidden">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
      <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
    </activity>
  </application>
</manifest>
