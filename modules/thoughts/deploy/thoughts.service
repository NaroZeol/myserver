[Unit]
Description=Thoughts API
After=network.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@DATA_DIR@/app
Environment=PYTHONPATH=@DATA_DIR@/python
Environment=THOUGHTS_DATABASE=@DATA_DIR@/thoughts.sqlite
Environment=THOUGHTS_ORIGIN=http://localhost:8765
Environment=THOUGHTS_DEV=1
Environment=THOUGHTS_TRUST_PROXY=0
ExecStart=/usr/bin/python3 -m gunicorn --workers 2 --bind 127.0.0.1:8765 --timeout 30 --access-logfile - --error-logfile - app:create_app()
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@DATA_DIR@

[Install]
WantedBy=multi-user.target
