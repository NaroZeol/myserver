[Unit]
Description=Publish queued Thoughts to Gist
After=network-online.target myserver.service

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
WorkingDirectory=@DATA_DIR@/app
Environment=PYTHONPATH=@DATA_DIR@/python
Environment=MYSERVER_DATABASE=@DATA_DIR@/myserver.sqlite
ExecStart=/usr/bin/python3 -m modules.thoughts.publisher
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@DATA_DIR@
