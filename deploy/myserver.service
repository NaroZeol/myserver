[Unit]
Description=myserver API

[Service]
Type=simple
WorkingDirectory=@DATA_DIR@/app
Environment=PYTHONPATH=@DATA_DIR@/python
Environment=MYSERVER_DATABASE=@DATA_DIR@/myserver.sqlite
Environment=MYSERVER_ORIGIN=http://localhost:8765
Environment=MYSERVER_DEV=1
Environment=MYSERVER_TRUST_PROXY=0
ExecStart=/usr/bin/python3 -m gunicorn --workers 2 --bind 127.0.0.1:8765 --timeout 30 --access-logfile - --error-logfile - app:create_app()
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
